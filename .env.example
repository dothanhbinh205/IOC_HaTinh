S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lakehouse
S3_USE_SSL=false
AWS_REGION=us-east-1

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123

ICEBERG_CATALOG=ioc
ICEBERG_CATALOG_TYPE=hadoop
ICEBERG_WAREHOUSE=s3a://lakehouse/iceberg/

# Must match PySpark 4.1 / Scala 2.13.
SPARK_PACKAGES=org.apache.iceberg:iceberg-spark-runtime-4.1_2.13:1.11.0,org.apache.iceberg:iceberg-aws-bundle:1.11.0,org.apache.hadoop:hadoop-aws:3.4.2
SPARK_IVY_DIR=.ivy2
SPARK_LOCAL_JARS_DIR=.ivy2/jars
SPARK_TEMP_DIR=.spark-tmp
# SPARK_MASTER=local[*]
