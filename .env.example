S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lakehouse
S3_USE_SSL=false
AWS_REGION=us-east-1

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123

POLARIS_URI=http://localhost:8181/api/catalog
ICEBERG_CATALOG=ioc
# Với Polaris, đây thường là tên catalog đã tạo trong Polaris.
ICEBERG_WAREHOUSE=ioc_catalog
# Bỏ trống 2 dòng dưới nếu REST catalog development không bật OAuth.
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL

# Phải khớp chính xác phiên bản Spark/Scala đang dùng.
# Ví dụ cho Spark 4.1 + Scala 2.13 + Iceberg 1.11:
SPARK_PACKAGES=org.apache.iceberg:iceberg-spark-runtime-4.1_2.13:1.11.0,org.apache.iceberg:iceberg-aws-bundle:1.11.0,org.apache.hadoop:hadoop-aws:3.4.2
# SPARK_MASTER=local[*]
